# Đường dẫn dữ liệu (mặc định Windows: %LOCALAPPDATA%/TuToMoFactory/data, Linux/macOS: ~/.local/share/TuToMoFactory/data)
DATA_DIR=
TZ_FACTORY=Asia/Ho_Chi_Minh
# Telegram — token KHÔNG đặt ở đây cho production; dùng `pnpm --filter @ttm/worker secrets set telegram.botToken`
TELEGRAM_ALLOWED_CHAT_IDS=
# LLM runtime (tùy chọn). Để trống => NEEDS_PROVIDER / kịch bản template xác định
LLM_BASE_URL=
LLM_MODEL=
# Web dashboard chỉ bind localhost/LAN
WEB_HOST=127.0.0.1
