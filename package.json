{
  "name": "tu-to-mo-factory",
  "private": true,
  "version": "0.1.0",
  "description": "T\u1ee7 T\u00f2 M\u00f2 \u2014 nh\u00e0 m\u00e1y n\u1ed9i dung t\u1ef1 v\u1eadn h\u00e0nh, l\u01b0u tr\u1eef file-only (kh\u00f4ng database).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ttm/web dev",
    "build": "pnpm typecheck && pnpm --filter @ttm/web build",
    "worker": "pnpm --filter @ttm/worker start",
    "worker:once": "pnpm --filter @ttm/worker once",
    "e2e:offline": "pnpm --filter @ttm/worker e2e",
    "doctor": "pnpm --filter @ttm/worker doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "factory": "pnpm --silent --filter @ttm/worker cli",
    "test:ui": "node apps/web/e2e/ui-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "1.56.1",
    "server-only": "^0.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  }
}
