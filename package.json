{
  "name": "autonomous-creative-studio",
  "private": true,
  "version": "0.1.0",
  "description": "AUTONOMOUS CREATIVE STUDIO — local AI production and publishing",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-build.ps1",
    "desktop:smoke": "node desktop/smoke.mjs",
    "dev": "pnpm --filter @ttm/web dev",
    "build": "pnpm typecheck && node scripts/build-web.mjs",
    "worker": "pnpm --filter @ttm/worker start",
    "worker:once": "pnpm --filter @ttm/worker once",
    "e2e:offline": "pnpm --filter @ttm/worker e2e",
    "doctor": "pnpm --filter @ttm/worker doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "factory": "pnpm --silent --filter @ttm/worker cli",
    "test:ui": "node apps/web/e2e/ui-smoke.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=.test-results.json; tsx scripts/gen-edge-matrix.ts .test-results.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "server-only": "^0.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  }
}
